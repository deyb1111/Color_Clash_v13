<?xml version="1.0" encoding="utf-8"?>
<!--
    Neon-outlined pill used by the "+ Add" (LOAD) and "BACK" buttons in
    the store.  Purple stroke matches the neon-arcade theme of the rest
    of the game.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0A0820" />
    <stroke
        android:width="2dp"
        android:color="#FFB279FF" />
    <corners android:radius="18dp" />
</shape>
