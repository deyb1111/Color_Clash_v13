<?xml version="1.0" encoding="utf-8"?>
<!--
    Trail preview strip used inside Store item rows.
    Renders a fading horizontal streak so users can see what a
    "Motion Trail" cosmetic looks like behind a moving player ball.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#00FFFFFF"
        android:centerColor="#66FFFFFF"
        android:endColor="#DDFFFFFF" />
    <corners android:radius="8dp" />
</shape>
