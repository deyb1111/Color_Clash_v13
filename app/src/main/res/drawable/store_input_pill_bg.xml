<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded pill background for the player-name selector in the store header.
    Cyan/teal neon stroke echoes the arcade frame in the reference layout.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0A0820" />
    <stroke
        android:width="2dp"
        android:color="#FF6FE3FF" />
    <corners android:radius="22dp" />
</shape>
