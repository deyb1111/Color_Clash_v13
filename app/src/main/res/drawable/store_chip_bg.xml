<?xml version="1.0" encoding="utf-8"?>
<!--
    Small rounded chip used as a color swatch next to a store item.
    The solid color is overridden at runtime via the asset reference
    when present; this XML supplies the fallback visual and the
    rounded outline.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF4444" />
    <stroke android:width="1dp" android:color="#66FFFFFF" />
    <corners android:radius="6dp" />
</shape>
