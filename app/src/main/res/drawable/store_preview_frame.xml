<?xml version="1.0" encoding="utf-8"?>
<!--
    Inner frame around each item's effect preview (ball + aura + trail).
    Helps the preview read as a self-contained "preview window" inside
    the row, similar to how the player cards group their balls.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A0A0A1A" />
    <stroke android:width="1dp" android:color="#55FFFFFF" />
    <corners android:radius="12dp" />
</shape>
