<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark rounded HUD pill that sits over the bottom of a cosmetic card.
    Holds the coin chip + price + Buy/Equip button so they stay readable
    on top of the PNG card art.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E60A0820" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
    <corners android:radius="22dp" />
</shape>
