<?xml version="1.0" encoding="utf-8"?>
<!--
    Multiplayer Menu — adaptive landscape layout that mirrors
    activity_offline_setup.xml.

    Weight distribution (vertical):
      logo spacer  : 28   (background image carries the logo —
                          bumped from 22 so the subtitle no longer
                          overlaps the COLOR CLASH wordmark)
      subtitle     : 6
      name card    : 16   (single-line name input, kept tight)
      host button  : 12
      join button  : 12
      back button  : 12   (now identical height to host/join)
      bottom pad   : 14
    Total          : 100

    All three primary buttons share the same horizontal margins
    (80dp) so they form a clean vertical stack of identical width.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background, matches Offline Mode -->
    <ImageView
        android:id="@+id/mp_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="Multiplayer background" />

    <!-- Overlay: all UI content stacked vertically with weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Spacer: logo area -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="28" />

        <!-- Subtitle (matches Offline Mode "✦  OFFLINE 2-PLAYER BATTLE  ✦") -->
        <TextView
            android:id="@+id/mp_subtitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:text="✦  MULTIPLAYER — CONNECT VIA HOTSPOT  ✦"
            android:textColor="#E0DEFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:gravity="center"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- Player Name card -->
        <LinearLayout
            android:id="@+id/mp_name_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="16"
            android:orientation="vertical"
            android:background="@drawable/card_bg_default"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/mp_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤  YOUR NAME"
                    android:textStyle="bold"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USED FOR BOTH SIDES"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <EditText
                android:id="@+id/multiplayer_player_name"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:hint="Enter name"
                android:textColor="#FFFFFF"
                android:textColorHint="#B9B9C8"
                android:textSize="14sp"
                android:background="@drawable/edit_text_bg_default"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:inputType="textPersonName"
                android:maxLength="12"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Host button (success green) -->
        <Button
            android:id="@+id/btn_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:text="🖥  Host a Game"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B5E20"
            app:cornerRadius="14dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="6dp" />

        <!-- Join button (info blue) -->
        <Button
            android:id="@+id/btn_join"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:text="📲  Join a Game"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D47A1"
            app:cornerRadius="14dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="6dp" />

        <!-- Back button (indigo) — same width as Host/Join -->
        <Button
            android:id="@+id/btn_back_mp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:text="🏠  Back to Menu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5C6BC0"
            app:cornerRadius="14dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="6dp" />

        <!-- Bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14" />

    </LinearLayout>
</FrameLayout>
