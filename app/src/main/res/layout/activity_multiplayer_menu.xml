<?xml version="1.0" encoding="utf-8"?>
<!-- activity_multiplayer_menu.xml -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/mp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 Multiplayer"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/mp_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect via Hotspot"
            android:textSize="14sp"
            android:textColor="#66BB6A"
            android:layout_marginTop="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Your player name"
            android:layout_marginTop="32dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/multiplayer_player_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="textPersonName"
                android:maxLength="12" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_host"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🖥  Host a Game"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B5E20"
            app:cornerRadius="14dp"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_join"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📲  Join a Game"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D47A1"
            app:cornerRadius="14dp"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btn_back_mp"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333355"
            app:cornerRadius="14dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
