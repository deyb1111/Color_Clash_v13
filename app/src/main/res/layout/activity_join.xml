<?xml version="1.0" encoding="utf-8"?>
<!--
    Join screen — adaptive landscape layout that mirrors
    activity_offline_setup.xml.

    Weight distribution (vertical):
      logo spacer  : 18
      subtitle     : 6
      status       : 8
      ip card      : 34  (IP input + hint)
      connect btn  : 12
      back button  : 10
      bottom pad   : 12
    Total          : 100
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background, matches Offline Mode -->
    <ImageView
        android:id="@+id/join_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="Join background" />

    <!-- Overlay: all UI content stacked vertically with weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Spacer: logo area -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:text="✦  JOIN GAME — ENTER HOST IP  ✦"
            android:textColor="#E0DEFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:gravity="center"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- Status banner: width scales with screen via weighted spacers. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

            <TextView
                android:id="@+id/join_status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:text="Status: WAITING_FOR_PLAYER"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#64B5F6"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#AA0044FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <!-- IP entry card row: card width is proportional (~83%).
             Weight bumped to 34 so the EditText inside has enough vertical
             room for a comfortable tap target on small landscape phones. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="34"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/ip_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:orientation="vertical"
                android:background="@drawable/card_bg_default"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

            <TextView
                android:id="@+id/join_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡  HOST CONNECTION"
                android:textStyle="bold"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOST IP ADDRESS"
                android:textColor="#AAAAAA"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:layout_marginTop="3dp" />

            <!-- Plain EditText keeps styling consistent with offline_setup;
                 Java still uses findViewById(host_ip_input).getText() so the
                 API is unchanged. Sized to its natural text height with a
                 48dp floor so it stays a comfortable tap target on every
                 device. -->
            <EditText
                android:id="@+id/host_ip_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="192.168.49.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#B9B9C8"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:background="@drawable/edit_text_bg_default"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:inputType="textUri"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/ip_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the host IP shown on the host screen"
                android:textSize="11sp"
                android:textColor="#9E9EBD"
                android:gravity="center"
                android:layout_marginTop="6dp" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <!-- Connect button row: primary CTA at ~68% width. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="6dp">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:text="🔌  Connect"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0D47A1"
                app:cornerRadius="14dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
        </LinearLayout>

        <!-- Back button row: secondary CTA at ~58% width. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="6dp">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />

            <Button
                android:id="@+id/btn_back_join"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:text="🏠  Back to Menu"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5C6BC0"
                app:cornerRadius="14dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />
        </LinearLayout>

        <!-- Bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12" />

    </LinearLayout>
</FrameLayout>
