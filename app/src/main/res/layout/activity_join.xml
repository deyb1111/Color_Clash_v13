<?xml version="1.0" encoding="utf-8"?>
<!--
    Join screen — adaptive landscape layout that mirrors
    activity_offline_setup.xml.

    Weight distribution (vertical):
      logo spacer  : 28
      subtitle     : 6
      status       : 7
      ip card      : 24   (header + caption + ip input + hint)
      connect btn  : 12
      back button  : 12   (same width / height as connect)
      bottom pad   : 11
    Total          : 100

    host_ip_input uses wrap_content + minHeight so the input field
    is always tall enough to be tappable on landscape phones.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background, matches Offline Mode -->
    <ImageView
        android:id="@+id/join_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="Join background" />

    <!-- Overlay: all UI content stacked vertically with weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Spacer: logo area -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="28" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:text="✦  JOIN GAME — ENTER HOST IP  ✦"
            android:textColor="#E0DEFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:gravity="center"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- Status banner (full-width so long strings don't get cut off) -->
        <TextView
            android:id="@+id/join_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:text="Status: WAITING_FOR_PLAYER"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#64B5F6"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#AA0044FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp" />

        <!-- IP entry card -->
        <LinearLayout
            android:id="@+id/ip_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24"
            android:orientation="vertical"
            android:background="@drawable/card_bg_default"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/join_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📡  HOST CONNECTION"
                    android:textStyle="bold"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOST IP ADDRESS"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- IP input: plain EditText (still typed as EditText in Java)
                 with wrap_content + minHeight so it always has enough
                 height to be tappable in landscape. -->
            <EditText
                android:id="@+id/host_ip_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:hint="192.168.49.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#B9B9C8"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:background="@drawable/edit_text_bg_default"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:inputType="textUri"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/ip_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the host IP shown on the host screen"
                android:textSize="11sp"
                android:textColor="#9E9EBD"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Connect button (info blue) — same width as Host/Join on the menu -->
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:text="🔌  Connect"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D47A1"
            app:cornerRadius="14dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="6dp" />

        <!-- Back button (indigo) — same width as Connect -->
        <Button
            android:id="@+id/btn_back_join"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:text="🏠  Back to Menu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5C6BC0"
            app:cornerRadius="14dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="6dp" />

        <!-- Bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="11" />

    </LinearLayout>
</FrameLayout>
