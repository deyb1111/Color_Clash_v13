<?xml version="1.0" encoding="utf-8"?>
<!--
    Host screen — adaptive landscape layout that mirrors
    activity_offline_setup.xml.

    Weight distribution (vertical):
      logo spacer    : 18
      subtitle       : 6
      status banner  : 8
      connection card: 36   (IP info + hint + progress)
      back button    : 10
      bottom pad     : 22
    Total            : 100
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background, matches Offline Mode -->
    <ImageView
        android:id="@+id/host_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="Host background" />

    <!-- Overlay: all UI content stacked vertically with weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Spacer: logo area -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:text="✦  HOSTING — WAITING FOR PLAYER  ✦"
            android:textColor="#E0DEFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:gravity="center"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- Status banner: width scales with screen via weighted spacers. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

            <TextView
                android:id="@+id/host_status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:text="Status: WAITING_FOR_PLAYER"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#66BB6A"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#AA00FF66"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <!-- Connection info card row: card width is proportional (~83%). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/host_info_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:orientation="vertical"
                android:background="@drawable/card_bg_default"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

            <TextView
                android:id="@+id/host_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡  CONNECTION INFO"
                android:textStyle="bold"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHARE WITH YOUR OPPONENT"
                android:textColor="#AAAAAA"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:layout_marginTop="3dp" />

            <!-- IP block (filled at runtime; uses the same panel style as the offline EditText) -->
            <TextView
                android:id="@+id/host_ip_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:text=""
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFEE44"
                android:fontFamily="monospace"
                android:gravity="center"
                android:visibility="gone"
                android:background="@drawable/edit_text_bg_default"
                android:padding="10dp"
                android:shadowColor="#AAFFAA00"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:layout_marginTop="6dp" />

            <!-- Hint line -->
            <TextView
                android:id="@+id/host_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Share the IP address with your opponent.\nThey enter it on the Join screen."
                android:textSize="11sp"
                android:textColor="#9E9EBD"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <!-- Progress spinner: small + centered -->
            <ProgressBar
                android:id="@+id/host_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:layout_marginTop="6dp" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <!-- Back button row: ~58% width for the secondary CTA. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="6dp">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />

            <Button
                android:id="@+id/btn_back_host"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:text="🏠  Back to Menu"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5C6BC0"
                app:cornerRadius="14dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />
        </LinearLayout>

        <!-- Bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="22" />

    </LinearLayout>
</FrameLayout>
