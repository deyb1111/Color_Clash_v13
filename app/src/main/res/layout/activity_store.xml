<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/store_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/bgoffline" android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="10"/>
        <LinearLayout android:id="@+id/store_header_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="13" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="4" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛒" android:textSize="22sp" android:textColor="#FFFFFFFF" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/store_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STORE" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:letterSpacing="0.18" android:shadowColor="#FFB279FF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="10"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:orientation="horizontal" android:gravity="end|center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/store_gold_pill_bg" android:paddingStart="10dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/store_coin_bg" android:gravity="center" android:text="G" android:textColor="#FF3D2900" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:id="@+id/store_gold_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="GOLD: —" android:textColor="#FFFFD23A" android:textStyle="bold" android:textSize="14sp" android:letterSpacing="0.08"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/store_input_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="13" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="4dp" android:paddingBottom="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:background="@drawable/store_input_pill_bg" android:paddingStart="14dp" android:paddingEnd="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="18sp" android:textColor="#FFFFFFFF" android:layout_marginEnd="8dp"/>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Your player name" android:textColor="#FFB9B9C8" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
                    <Spinner android:id="@+id/store_profile_spinner" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:background="@android:color/transparent" android:popupBackground="#FF12102C"/>
                    <TextView android:id="@+id/store_empty_hint" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="No profiles yet — play a game first" android:textColor="#FFB9B9C8" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
            <Space android:layout_width="14dp" android:layout_height="match_parent"/>
            <Button android:id="@+id/store_add_profile_btn" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:text="LOAD" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.12" android:minHeight="0dp" android:minWidth="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@drawable/store_action_pill_bg"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" android:gravity="center" android:text="· · · ✦ FEATURED ITEMS ✦ · · ·" android:textColor="#FFE0DEFF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.18" android:shadowColor="#AA6600FF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="10"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/store_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="48" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:overScrollMode="never" android:scrollbars="none"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="8" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
            <Button android:id="@+id/store_back" style="?android:attr/borderlessButtonStyle" android:layout_width="170dp" android:layout_height="48dp" android:text="← BACK" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" android:letterSpacing="0.12" android:minHeight="0dp" android:minWidth="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@drawable/store_action_pill_bg"/>
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3"/>
    </LinearLayout>
</FrameLayout>