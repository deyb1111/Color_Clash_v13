<?xml version="1.0" encoding="utf-8"?>
<!--
    Store screen — neon arcade redesign that matches the reference layout
    while reusing the bgoffline backdrop used by every other game screen.

    Layout shape:

        ╭──────────────────────────────────────────────────────────────╮
        │  ▓ COLOR CLASH logo │  🛒 STORE  │       │ G  GOLD: 1250  ▓ │
        │      ╭ 👤  Your player name ─────────────╮   ╭ LOAD ╮       │
        │      ╰─────────────────────────────────╯   ╰──────╯        │
        │              · · ·   ✦  FEATURED ITEMS  ✦   · · ·            │
        │   ╭───╮ ╭───╮ ╭───╮ ╭───╮ ╭───╮ ╭───╮ ╭───╮ ╭───╮            │
        │   │name│ │name│ │name│ │name│ │name│ │name│ │name│ │name│   │
        │   │ ▣  │ │ ▣  │ │ ▣  │ │ ▣  │ │ ▣  │ │ ▣  │ │ ▣  │ │ ▣  │   │
        │   │ G  │ │ G  │ │ G  │ │ G  │ │ G  │ │ G  │ │ G  │ │ G  │   │
        │   ╰───╯ ╰───╯ ╰───╯ ╰───╯ ╰───╯ ╰───╯ ╰───╯ ╰───╯            │
        │                       ╭ ← BACK ╮                            │
        ╰──────────────────────────────────────────────────────────────╯

    Weight distribution (vertical):
      logo spacer  : 10   (background image carries the COLOR CLASH wordmark)
      header row   : 13   (STORE title + gold pill)
      name row     : 13   (player selector + LOAD pill)
      section line :  5   (✦ FEATURED ITEMS ✦)
      cards row    : 46   (horizontal RecyclerView of cosmetic cards)
      back button  : 10
      bottom pad   :  3
    Total          : 100
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background (same image used by offline_setup / multiplayer) -->
    <ImageView
        android:id="@+id/store_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Overlay content stacked vertically with weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Logo spacer (bgoffline.png already paints the COLOR CLASH wordmark) -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- Header row: STORE title (center) + GOLD pill (right) -->
        <LinearLayout
            android:id="@+id/store_header_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="13"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <!-- Gutter for the COLOR CLASH wordmark painted on the left of bgoffline -->
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3" />

            <!-- 🛒 STORE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒"
                    android:textSize="22sp"
                    android:textColor="#FFFFFFFF"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/store_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STORE"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:letterSpacing="0.18"
                    android:shadowColor="#FFB279FF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10" />
            </LinearLayout>

            <!-- GOLD: 1250 pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/store_gold_pill_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/store_coin_bg"
                        android:gravity="center"
                        android:text="G"
                        android:textColor="#FF3D2900"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/store_gold_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="GOLD: —"
                        android:textColor="#FFFFD23A"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.08" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Name input row: 👤 player selector + LOAD pill -->
        <LinearLayout
            android:id="@+id/store_input_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="13"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <!-- Profile pill: 👤 + spinner / empty hint -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:background="@drawable/store_input_pill_bg"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="18sp"
                    android:textColor="#FFFFFFFF"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/store_profile_spinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:popupBackground="#FF12102C" />

                <TextView
                    android:id="@+id/store_empty_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your player name — play a game first"
                    android:textColor="#FFB9B9C8"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="match_parent" />

            <!-- LOAD pill (existing "+ Add profile" button restyled) -->
            <Button
                android:id="@+id/store_add_profile_btn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="LOAD"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.18"
                android:background="@drawable/store_action_pill_bg" />

        </LinearLayout>

        <!-- ✦ FEATURED ITEMS ✦ divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:gravity="center"
            android:text="·  ·  ·    ✦  FEATURED ITEMS  ✦    ·  ·  ·"
            android:textColor="#FFE0DEFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10" />

        <!-- Horizontal cosmetic cards (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/store_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="46"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- BACK pill (centered horizontally) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <Button
                android:id="@+id/store_back"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="170dp"
                android:layout_height="48dp"
                android:text="←  BACK"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:letterSpacing="0.18"
                android:background="@drawable/store_action_pill_bg" />
        </LinearLayout>

        <!-- Bottom safe-area pad -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

    </LinearLayout>
</FrameLayout>
