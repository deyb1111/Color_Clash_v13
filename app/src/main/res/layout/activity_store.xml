<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fitsSystemWindows="true"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/store_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛒 Store"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/store_gold_balance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Gold: —"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFDD22"
        android:gravity="end"
        app:layout_constraintTop_toBottomOf="@id/store_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />

    <!-- Profile selector row: Spinner + Add button -->
    <LinearLayout
        android:id="@+id/store_input_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/store_gold_balance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <!-- Profile spinner -->
        <Spinner
            android:id="@+id/store_profile_spinner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#1A1A2E"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <!-- No profiles hint -->
        <TextView
            android:id="@+id/store_empty_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No profiles yet — play a game first!"
            android:textColor="#9E9EBD"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Add new profile button -->
        <Button
            android:id="@+id/store_add_profile_btn"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:text="+ Add"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5C6BC0" />
    </LinearLayout>

    <Button
        android:id="@+id/store_back"
        android:layout_width="150dp"
        android:layout_height="46dp"
        android:text="← Back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333355"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/store_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/store_input_row"
        app:layout_constraintBottom_toTopOf="@id/store_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
