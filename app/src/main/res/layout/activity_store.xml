<?xml version="1.0" encoding="utf-8"?>
<!--
    Store screen — adaptive landscape layout that mirrors
    activity_offline_setup.xml so the two screens read as siblings.

    Weight distribution (vertical):
      logo spacer  : 22  (background image carries the logo)
      subtitle     : 6
      header card  : 14  (profile selector + gold balance)
      items panel  : 46  (RecyclerView inside translucent card)
      back button  : 9
      bottom pad   : 3
    Total          : 100
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background, matches Offline Mode -->
    <ImageView
        android:id="@+id/bg_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="Store background" />

    <!-- Overlay: all UI content stacked vertically with weights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Spacer: logo area (background handles the logo visually) -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="22" />

        <!-- Subtitle (matches Offline Mode "✦  OFFLINE 2-PLAYER BATTLE  ✦") -->
        <TextView
            android:id="@+id/store_subtitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:text="✦  STORE — COSMETICS &amp; TRAILS  ✦"
            android:textColor="#E0DEFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:gravity="center"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- Header card: profile selector + gold balance, styled like a player card -->
        <LinearLayout
            android:id="@+id/store_header_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:background="@drawable/card_bg_default"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp">

            <!-- Profile selector column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤  PROFILE"
                    android:textStyle="bold"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT PLAYER"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp" />

                <!-- Profile spinner: same panel as offline EditText -->
                <Spinner
                    android:id="@+id/store_profile_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/edit_text_bg_default"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginTop="3dp" />

                <!-- No profiles hint -->
                <TextView
                    android:id="@+id/store_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No profiles yet — play a game first!"
                    android:textColor="#B9B9C8"
                    android:textSize="11sp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Add profile button column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEW"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08" />

                <Button
                    android:id="@+id/store_add_profile_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="+ Add"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:minWidth="84dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:backgroundTint="#5C6BC0"
                    app:cornerRadius="10dp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Vertical divider, mirrors the VS badge spacing in offline_setup -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <!-- Gold balance column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰  WALLET"
                    android:textStyle="bold"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:layout_gravity="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOLD BALANCE"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/store_gold_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gold: —"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFDD22"
                    android:shadowColor="#AAFFAA00"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"
                    android:layout_marginTop="3dp"
                    android:layout_gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Items panel: translucent card hosting the RecyclerView -->
        <LinearLayout
            android:id="@+id/store_items_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="46"
            android:orientation="vertical"
            android:background="@drawable/store_panel_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="6dp">

            <!-- Column header strip, mirrors the "CHOOSE COLOR" caption rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREVIEW"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:minWidth="84dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ITEM"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRICE"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:minWidth="56dp"
                    android:gravity="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTION"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:minWidth="86dp"
                    android:gravity="end" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/store_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Back button: mirrors the Start Battle button placement / scale -->
        <Button
            android:id="@+id/store_back"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            android:text="🏠  Back to Menu"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:backgroundTint="#5C6BC0"
            app:cornerRadius="14dp"
            android:layout_marginStart="100dp"
            android:layout_marginEnd="100dp"
            android:layout_marginTop="6dp" />

        <!-- Bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

    </LinearLayout>
</FrameLayout>
