<?xml version="1.0" encoding="utf-8"?>
<!--
    Game Over screen — neon/arcade theme matching Offline Mode &
    Multiplayer Menu (bgoffline backdrop, caps subtitle, card_bg_default
    result panel, glow shadows on text, weighted landscape layout).

    Weight distribution (vertical):
      logo spacer : 18
      subtitle    : 6
      result card : 44
      buttons row : 14
      bottom pad  : 18
    Total         : 100
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/game_over_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bgoffline"
        android:scaleType="fitXY"
        android:contentDescription="Game over background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Logo spacer (bgoffline shows the Color Clash logo here) -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:text="✦  MATCH RESULT  ✦"
            android:textColor="#E0DEFF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:gravity="center"
            android:shadowColor="#AA6600FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- Result card row: card width is proportional (~83%). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="44"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/game_over_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg_default"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/game_over_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAME OVER"
                    android:textSize="12sp"
                    android:textColor="#9E9EBD"
                    android:letterSpacing="0.2" />

                <!-- Winner name + Wins! — color is set in Java to winner color. -->
                <TextView
                    android:id="@+id/winner_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Winner!"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:shadowColor="#AAFFAA00"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10"
                    android:layout_marginTop="4dp" />

                <!-- Thin divider so the score block reads as a sub-section. -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#33E0DEFF" />

                <TextView
                    android:id="@+id/score_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scores"
                    android:textSize="14sp"
                    android:textColor="#E0DEFF"
                    android:gravity="center"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/gold_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gold earned"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFDD22"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#AAFFAA00"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <!-- Buttons row: Play Again (success green) + Main Menu (indigo). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="8dp">

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />

            <!-- ID "play_again" matches existing findViewById; now actually
                 wired to relaunch the game (was labelled Main Menu before). -->
            <Button
                android:id="@+id/play_again"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:text="🔁  Play Again"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1B5E20"
                app:cornerRadius="14dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

            <Button
                android:id="@+id/btn_main_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:text="🏠  Main Menu"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5C6BC0"
                app:cornerRadius="14dp" />

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
        </LinearLayout>

        <!-- Bottom padding -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />

    </LinearLayout>
</FrameLayout>
