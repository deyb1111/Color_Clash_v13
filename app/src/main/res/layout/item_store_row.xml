<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#1A1A30"
    android:padding="14dp"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="4dp">

    <!-- Item colour dot (asset colour) -->
    <View
        android:id="@+id/store_item_dot"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="#FF4444"
        android:layout_marginEnd="12dp"/>

    <!-- Name + type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/store_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/store_item_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COSMETIC"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="#5C6BC0"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Price -->
    <TextView
        android:id="@+id/store_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50 🪙"
        android:textSize="15sp"
        android:textColor="#FFDD22"
        android:layout_marginEnd="12dp"/>

    <!-- Buy button -->
    <Button
        android:id="@+id/store_buy_btn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Buy"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:backgroundTint="#7B1FA2"
        android:visibility="visible"/>

    <!-- Equip / Unequip button -->
    <Button
        android:id="@+id/store_equip_btn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Equip"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:backgroundTint="#00897B"
        android:visibility="gone"/>

</LinearLayout>
