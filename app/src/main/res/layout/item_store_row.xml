<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/store_item_card" android:layout_width="158dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:clipChildren="false" android:clipToPadding="false">
    <ImageView android:id="@+id/store_item_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="false" android:scaleType="fitCenter" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:background="@drawable/store_overlay_pill_bg" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/store_coin_bg" android:gravity="center" android:text="G" android:textColor="#FF3D2900" android:textStyle="bold" android:textSize="10sp"/>
        <TextView android:id="@+id/store_item_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_marginEnd="8dp" android:text="500" android:textColor="#FFFFD23A" android:textStyle="bold" android:textSize="12sp" android:singleLine="true" android:includeFontPadding="false"/>
        <Button android:id="@+id/store_buy_btn" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:textAllCaps="false" android:paddingTop="0dp" android:paddingBottom="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:text="BUY" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="10sp" android:letterSpacing="0.04" android:background="@drawable/store_action_pill_bg"/>
        <Button android:id="@+id/store_equip_btn" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:textAllCaps="false" android:paddingTop="0dp" android:paddingBottom="0dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:text="EQUIP" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="10sp" android:letterSpacing="0.04" android:visibility="gone" android:background="@drawable/store_action_pill_bg"/>
    </LinearLayout>
    <TextView android:id="@+id/store_item_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="Item Name"/>
    <TextView android:id="@+id/store_item_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="COSMETIC"/>
    <View android:id="@+id/store_item_dot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</FrameLayout>