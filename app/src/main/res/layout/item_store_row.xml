<?xml version="1.0" encoding="utf-8"?>
<!--
    One cosmetic card in the Store screen's horizontal RecyclerView.

    The user's PNG drawables (drawable-nodpi/crimson_aura.png,
    drawable-nodpi/fire_trail.png, etc.) already bake in the card border,
    the cosmetic title and the cosmetic art, so this layout deliberately
    avoids adding a second outer frame — the PNG IS the card.

    Visual order (bottom of card carries the HUD overlay):
        ┌────────────────┐
        │   <PNG card>   │   ← @id/store_item_preview  (PNG)
        │     name       │     │
        │      art       │     │
        │                │     │
        │  ╭ G 100 BUY ╮ │   ← overlay pill (coin + price + buy/equip)
        └────────────────┘

    Every Java-visible @+id from the previous adapter is preserved with
    the same View type so StoreActivity / StoreAdapter keep working —
    we only stop drawing a redundant outer neon frame and we stop
    tinting the card outline (each PNG already carries its own colour).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/store_item_card"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Preview image: PNG from res/drawable-nodpi loaded by the adapter.
         layout_height=match_parent + width=wrap_content + adjustViewBounds
         lets the card size itself to the PNG's natural aspect ratio, so
         the row of cards inherits the trading-card portrait shape. -->
    <ImageView
        android:id="@+id/store_item_preview"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Bottom-anchored HUD overlay: dark rounded pill carrying the price
         and Buy/Equip action. Sits inside the card's empty bottom band. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:background="@drawable/store_overlay_pill_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- Yellow coin chip -->
        <TextView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/store_coin_bg"
            android:gravity="center"
            android:text="G"
            android:textColor="#FF3D2900"
            android:textStyle="bold"
            android:textSize="10sp" />

        <!-- Price -->
        <TextView
            android:id="@+id/store_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"
            android:text="500"
            android:textColor="#FFFFD23A"
            android:textStyle="bold"
            android:textSize="13sp"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Buy pill (shown when not owned) -->
        <Button
            android:id="@+id/store_buy_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="BUY"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:background="@drawable/store_action_pill_bg" />

        <!-- Equip pill (shown when owned) -->
        <Button
            android:id="@+id/store_equip_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="EQUIP"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:visibility="gone"
            android:background="@drawable/store_action_pill_bg" />
    </LinearLayout>

    <!-- Hidden compat IDs — StoreAdapter still calls setText / setBackgroundColor
         on these, but the PNG already shows the title and the type badge would
         visually clash with the card art, so they stay invisible. -->
    <TextView
        android:id="@+id/store_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Item Name" />

    <TextView
        android:id="@+id/store_item_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="COSMETIC" />

    <View
        android:id="@+id/store_item_dot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
